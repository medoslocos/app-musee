# Secrets et surcharges — copier en .env et remplir (NE PAS versionner .env).
# Ces variables ont priorité sur config.yaml.

# --- Telegram ---------------------------------------------------------
# Créer un bot via @BotFather, récupérer le token.
TELEGRAM_BOT_TOKEN=
# Identifiant du chat/canal destinataire (nombre ou @canal).
TELEGRAM_CHAT_ID=
# Tant que vide/true, aucune alerte n'est envoyée : elle est affichée sur
# stdout. Passer à "false" pour activer l'envoi réel.
TELEGRAM_DRY_RUN=true

# --- Divers -----------------------------------------------------------
# Intervalle entre deux cycles, en heures (défaut 3.5, brief : 3-4h).
VEILLE_INTERVALLE_HEURES=3.5
# Chemin de la base SQLite d'historique.
VEILLE_DB_PATH=veille.db
